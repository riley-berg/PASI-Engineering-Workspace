{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pasi.local/schemas/roadmap-v4.json",
  "title":"PASI roadmap v4",
  "type":"object",
  "required":["roadmap_id","version","revision","phases","tasks","canonical_sha256"],
  "properties":{
    "roadmap_id":{"type":"string","minLength":1,"maxLength":256},
    "version":{"const":4},
    "revision":{"type":"integer","minimum":0},
    "phases":{"type":"array"},
    "tasks":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["id","title","phase_id","depends_on","acceptance_requirements","evidence_requirements","parent_task_id","source_issue_number","source_url","source_title","status","revision"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "title":{"type":"string","minLength":1},
          "phase_id":{"type":"string","minLength":1},
          "depends_on":{"type":"array","items":{"type":"string"}},
          "acceptance_requirements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "evidence_requirements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "parent_task_id":{"type":"string"},
          "source_issue_number":{"type":["integer","null"],"minimum":1},
          "source_url":{"type":"string"},
          "source_title":{"type":"string"},
          "status":{"enum":["planned","active","blocked","completed","archived"]},
          "revision":{"type":"integer","minimum":0}
        },
        "additionalProperties":false
      }
    },
    "canonical_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}
