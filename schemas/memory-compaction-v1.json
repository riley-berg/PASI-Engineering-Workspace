{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pasi.local/schemas/memory-compaction-v1.json",
  "title":"PASI memory compaction plan v1",
  "type":"object",
  "required":["scope","kind","canonical_id","redundant_ids","merged_provenance_refs"],
  "properties":{
    "scope":{"type":"string","minLength":1},
    "kind":{"type":"string","minLength":1},
    "canonical_id":{"type":"string","minLength":1},
    "redundant_ids":{"type":"array","items":{"type":"string","minLength":1}},
    "merged_provenance_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  },
  "additionalProperties":false
}