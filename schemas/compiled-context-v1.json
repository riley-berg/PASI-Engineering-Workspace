{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pasi.local/schemas/compiled-context-v1.json",
  "title":"PASI compiled context v1",
  "type":"object",
  "required":["compiler_version","task_id","scope","sources","context_text","source_ids","provenance_refs","sha256"],
  "properties":{
    "compiler_version":{"const":1},
    "task_id":{"type":"string","minLength":1},
    "scope":{"type":"string","minLength":1},
    "sources":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["source_id","kind","text","provenance_refs"],
        "properties":{
          "source_id":{"type":"string","minLength":1},
          "kind":{"type":"string","minLength":1},
          "text":{"type":"string","minLength":1},
          "provenance_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
        },
        "additionalProperties":false
      }
    },
    "context_text":{"type":"string"},
    "source_ids":{"type":"array","items":{"type":"string"}},
    "provenance_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}