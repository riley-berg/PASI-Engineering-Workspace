{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pasi.local/schemas/retrieved-memory-v1.json",
  "title":"PASI retrieved memory v1",
  "type":"object",
  "required":["memory_id","scope","kind","content","provenance_refs","score","matched_terms"],
  "properties":{
    "memory_id":{"type":"string","minLength":1},
    "scope":{"type":"string","minLength":1},
    "kind":{"type":"string","minLength":1},
    "content":{"type":"string","minLength":1},
    "provenance_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "score":{"type":"number","minimum":0,"maximum":1},
    "matched_terms":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":false
}
