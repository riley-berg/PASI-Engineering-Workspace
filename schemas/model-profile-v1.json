{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pasi.local/schemas/model-profile-v1.json",
  "title":"PASI local model profile v1",
  "type":"object",
  "required":["version","name","provider","model","required_capabilities","min_context_window_tokens","max_output_tokens","configuration_provenance"],
  "properties":{
    "version":{"const":1},
    "name":{"type":"string","minLength":1,"maxLength":128},
    "provider":{"type":"string","minLength":1},
    "model":{"type":"string","minLength":1,"maxLength":256},
    "required_capabilities":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "min_context_window_tokens":{"type":"integer","minimum":1},
    "max_output_tokens":{"type":"integer","minimum":1},
    "configuration_provenance":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1}}
  },
  "additionalProperties":false
}
