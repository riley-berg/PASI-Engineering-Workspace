{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pasi.local/schemas/terminal-command-v1.json",
  "title":"PASI typed terminal command v1",
  "type":"object",
  "required":["operation_id","argv","cwd","timeout_seconds","max_output_bytes"],
  "properties":{
    "operation_id":{"type":"string","minLength":1},
    "argv":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "cwd":{"type":"string","minLength":1},
    "timeout_seconds":{"type":"number","exclusiveMinimum":0,"maximum":300},
    "max_output_bytes":{"type":"integer","minimum":1,"maximum":10000000},
    "env":{"type":"object","additionalProperties":{"type":"string"}}
  },
  "additionalProperties":false
}