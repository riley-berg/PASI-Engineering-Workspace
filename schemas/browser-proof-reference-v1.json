{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pasi.local/schemas/browser-proof-reference-v1.json",
  "title": "PASI Browser Proof Reference v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source": {
      "type": "string",
      "maxLength": 2000
    },
    "url": {
      "type": "string",
      "maxLength": 2000
    },
    "url_contains": {
      "type": "string",
      "maxLength": 2000
    },
    "required_text": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 5000
      },
      "maxItems": 100
    },
    "required_elements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "count_min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "tag": {
            "type": "string",
            "maxLength": 50
          },
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "class_name": {
            "type": "string",
            "maxLength": 500
          },
          "role": {
            "type": "string",
            "maxLength": 100
          },
          "aria_label": {
            "type": "string",
            "maxLength": 500
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "test_id": {
            "type": "string",
            "maxLength": 500
          },
          "type": {
            "type": "string",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 500
          },
          "text": {
            "type": "string",
            "maxLength": 5000
          },
          "visible": {
            "type": "boolean"
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "accessibility": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 1000
          },
          "target": {
            "type": "string",
            "maxLength": 1000
          },
          "role": {
            "type": "string",
            "maxLength": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "action": {
            "enum": [
              "screenshot",
              "page_state",
              "dom",
              "accessibility",
              "console_errors",
              "network",
              "click",
              "fill",
              "press_key",
              "scroll"
            ]
          },
          "params": {
            "type": "object",
            "maxProperties": 50
          },
          "expect": {
            "type": "object",
            "properties": {
              "url_contains": {
                "type": "string",
                "maxLength": 2000
              },
              "text": {
                "type": "string",
                "maxLength": 5000
              }
            },
            "additionalProperties": false
          },
          "settle_ms": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "additionalProperties": false
      }
    },
    "require_no_console_errors": {
      "type": "boolean"
    },
    "network_requirements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "url_contains": {
            "type": "string",
            "maxLength": 2000
          },
          "resource_type": {
            "type": "string",
            "maxLength": 100
          },
          "kind": {
            "enum": [
              "request",
              "response",
              "finished",
              "failed"
            ]
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "count_min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    "screenshot_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false
}
