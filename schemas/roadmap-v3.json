{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pasi.local/schemas/roadmap-v3.json",
  "title": "PASI roadmap v3",
  "type": "object",
  "required": ["roadmap_id","version","phases","tasks"],
  "properties": {
    "roadmap_id":{"type":"string","minLength":1,"maxLength":256},
    "version":{"const":3},
    "revision":{"type":"integer","minimum":0},
    "phases":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["id","title"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "title":{"type":"string","minLength":1},
          "depends_on":{"type":"array","items":{"type":"string"}},
          "status":{"enum":["planned","active","paused","completed","archived"]},
          "revision":{"type":"integer","minimum":0}
        },
        "additionalProperties":false
      }
    },
    "tasks":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["id","title","phase_id","acceptance_requirements","evidence_requirements"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "title":{"type":"string","minLength":1},
          "phase_id":{"type":"string","minLength":1},
          "depends_on":{"type":"array","items":{"type":"string"}},
          "acceptance_requirements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "evidence_requirements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "parent_task_id":{"type":"string"},
          "status":{"enum":["planned","active","blocked","completed","archived"]},
          "revision":{"type":"integer","minimum":0}
        },
        "additionalProperties":false
      }
    },
    "canonical_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}
