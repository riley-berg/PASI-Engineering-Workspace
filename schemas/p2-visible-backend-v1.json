{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pasi.local/schemas/p2-visible-backend-v1.json",
  "title":"PASI visible backend coverage v1",
  "type":"object",
  "required":["dependency_graph","task_detail","ranking_explanation","workspace_preference","search_result","project_sync_state","notification"],
  "properties":{
    "dependency_graph":{
      "type":"object",
      "required":["roadmap_id","roadmap_revision","prerequisites","dependents","eligible_task_ids","blocked_reasons","canonical_sha256"],
      "properties":{
        "roadmap_id":{"type":"string","minLength":1},
        "roadmap_revision":{"type":"integer","minimum":0},
        "prerequisites":{"type":"object"},
        "dependents":{"type":"object"},
        "eligible_task_ids":{"type":"array","items":{"type":"string"}},
        "blocked_reasons":{"type":"object","additionalProperties":{"type":"string"}},
        "canonical_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      },
      "additionalProperties":false
    },
    "task_detail":{
      "type":"object",
      "required":["roadmap_id","roadmap_revision","task","phase","prerequisites","dependents","selected","queued","operation_history","event_count"],
      "properties":{
        "roadmap_id":{"type":"string"},
        "roadmap_revision":{"type":"integer","minimum":0},
        "task":{"type":"object"},
        "phase":{"type":"object"},
        "prerequisites":{"type":"array","items":{"type":"string"}},
        "dependents":{"type":"array","items":{"type":"string"}},
        "selected":{"type":["boolean","null"]},
        "queued":{"type":"boolean"},
        "operation_history":{"type":"array","items":{"type":"object"}},
        "event_count":{"type":"integer","minimum":0}
      },
      "additionalProperties":false
    },
    "ranking_explanation":{
      "type":"object",
      "required":["roadmap_id","roadmap_revision","selected_task_id","candidates","canonical_sha256","created_at"],
      "properties":{
        "roadmap_id":{"type":"string"},
        "roadmap_revision":{"type":"integer","minimum":0},
        "selected_task_id":{"type":["string","null"]},
        "candidates":{"type":"array","items":{"type":"object"}},
        "canonical_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "created_at":{"type":"string","format":"date-time"}
      },
      "additionalProperties":false
    },
    "workspace_preference":{
      "type":"object",
      "required":["scope","key","value","revision"],
      "properties":{
        "scope":{"type":"string","minLength":1},
        "key":{"type":"string","minLength":1},
        "value":{},
        "revision":{"type":"integer","minimum":0}
      },
      "additionalProperties":false
    },
    "search_result":{
      "type":"object",
      "required":["document_id","scope","kind","title","deep_link","freshness","score","matched_terms"],
      "properties":{
        "document_id":{"type":"string"},
        "scope":{"type":"string"},
        "kind":{"type":"string"},
        "title":{"type":"string"},
        "deep_link":{"type":"string"},
        "freshness":{"enum":["fresh","stale"]},
        "score":{"type":"number","minimum":0},
        "matched_terms":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":false
    },
    "project_sync_state":{
      "type":"object",
      "required":["project_ref","roadmap_id","local_revision","last_remote_revision","status","last_success_at","last_error","source"],
      "properties":{
        "project_ref":{"type":"string"},
        "roadmap_id":{"type":"string"},
        "local_revision":{"type":"integer","minimum":0},
        "last_remote_revision":{"type":"string"},
        "status":{"enum":["success","failed"]},
        "last_success_at":{"type":"string"},
        "last_error":{"type":"string"},
        "source":{"type":"string"}
      },
      "additionalProperties":false
    },
    "notification":{
      "type":"object",
      "required":["notification_id","scope","source_event_id","severity","message","entity_type","entity_id","occurred_at","acknowledged","revision"],
      "properties":{
        "notification_id":{"type":"string"},
        "scope":{"type":"string"},
        "source_event_id":{"type":"string"},
        "severity":{"enum":["info","warning","error","critical"]},
        "message":{"type":"string"},
        "entity_type":{"type":"string"},
        "entity_id":{"type":"string"},
        "occurred_at":{"type":"string","format":"date-time"},
        "acknowledged":{"type":"boolean"},
        "revision":{"type":"integer","minimum":0}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
