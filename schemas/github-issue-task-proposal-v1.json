{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pasi.local/schemas/github-issue-task-proposal-v1.json",
  "title":"PASI GitHub issue task proposal v1",
  "type":"object",
  "required":["version","task_id","source_issue_number","source_url","source_title","acceptance_requirements","evidence_requirements"],
  "properties":{
    "version":{"const":1},
    "task_id":{"type":"string","minLength":1},
    "source_issue_number":{"type":"integer","minimum":1},
    "source_url":{"type":"string","format":"uri"},
    "source_title":{"type":"string","minLength":1},
    "acceptance_requirements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "evidence_requirements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  },
  "additionalProperties":false
}