{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pasi.local/schemas/runtime-control-result-v1.json",
  "title":"PASI runtime control result v1",
  "type":"object",
  "required":["command_id","operation_id","action","status","state_revision"],
  "properties":{
    "command_id":{"type":"string","minLength":1},
    "operation_id":{"type":"string","minLength":1},
    "action":{"enum":["start","stop","retry","recover"]},
    "status":{"type":"string"},
    "state_revision":{"type":"integer","minimum":0}
  },
  "additionalProperties":false
}
