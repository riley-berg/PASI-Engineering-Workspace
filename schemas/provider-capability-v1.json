{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pasi.local/schemas/provider-capability-v1.json",
  "title":"PASI provider capability v1",
  "type":"object",
  "required":["provider","registry_version","models","capabilities","context_window_tokens","max_output_tokens","configuration_provenance","metadata"],
  "properties":{
    "provider":{"type":"string","minLength":1,"maxLength":128},
    "registry_version":{"const":1},
    "models":{"type":"array","minItems":1,"items":{"type":"string","minLength":1,"maxLength":256}},
    "capabilities":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"string","minLength":1}},
    "context_window_tokens":{"type":"integer","minimum":1,"maximum":2000000},
    "max_output_tokens":{"type":"integer","minimum":1,"maximum":200000},
    "configuration_provenance":{"type":"string","minLength":1,"maxLength":1024},
    "metadata":{"type":"object","additionalProperties":{"type":"string"}}
  },
  "additionalProperties":false
}
