{
  "private": true,
  "scripts": {
    "build:userscript-compiler": "node scripts/build_userscript_compiler.mjs",
    "lint:userscripts": "eslint --config eslint.config.mjs extensions/pasi-chatgpt/src/userscript_*.js extensions/pasi-chatgpt/src/background-userscripts.js extensions/pasi-chatgpt/src/api_v4.js extensions/pasi-chatgpt/src/background.js extensions/pasi-chatgpt/options.js extensions/pasi-chatgpt/popup.js extensions/pasi-chatgpt/editor.js",
    "build:extension": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build_extension.ps1 -SkipInstall",
    "deploy:extension": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy_extension.ps1 -SkipInstall",
    "verify:extension": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify_extension_deployment.ps1",
    "bridge:run": "bash scripts/run_bridge.sh",
    "bridge:verify": "python scripts/verify_bridge.py",
    "bridge:token": "python scripts/provision_bridge_token.py",
    "test:extension": "node --test tests/native_extension_runtime.test.js"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "eslint": "10.11.0",
    "typescript-browser": "npm:typescript@6.0.3"
  }
}
